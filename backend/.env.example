NODE_ENV=development
PORT=4000
HOST=0.0.0.0
PUBLIC_SITE_URL=http://localhost:5173
# Comma separated. The dev server, the E2B preview (*.e2b.app) and any
# deployment behind a reverse proxy are all allowed automatically.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =====================================================================
# XAMPP MySQL Database Configuration (Default XAMPP Settings)
# 1. Start Apache + MySQL in XAMPP Control Panel
# 2. Backend auto-imports ultradownloader_xampp.sql (or import manually)
# =====================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ultradownloader_db

# Permanent Admin Vault Storage Path (Temp muxing automatically uses fast OS Temp outside OneDrive!)
VAULT_STORAGE_DIR=./storage/vault

# =====================================================================
# SUPER-ADMIN — ShakeelAdminProDownloader  (source of truth for credentials)
# The console lives at  /vault-control-x9p4  (Pro-Security aliases also work)
# Change these values and restart: the SQL row is re-hashed automatically.
# =====================================================================
ADMIN_EMAIL=shakeelaijaz559986@gmail.com
ADMIN_USERNAME=shakeeladminprod
ADMIN_FULL_NAME=Shakeel Ahmed — Super Admin
ADMIN_PASSWORD=change-this-master-password
ADMIN_PIN=change-this-pin
ADMIN_STATIC_2FA_CODE=change-this-2fa-code
ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP
ADMIN_MAX_FAILED_ATTEMPTS=3
ADMIN_BAN_DURATION_MINUTES=30
ADMIN_IP_ALLOWLIST=

# 5-Layer Super-Admin Padlock, TOTP 2FA & AES-256 Cookie Vault
JWT_ADMIN_SECRET=generate-a-64-char-random-secret
JWT_USER_SECRET=generate-a-64-char-random-secret
PADLOCK_TICKET_SECRET=generate-a-64-char-random-secret
AES_256_VAULT_KEY=64-hex-characters

# Short signed download tickets (payload stays server-side -> URLs never truncate)
DOWNLOAD_TICKET_TTL_SECONDS=900
DOWNLOAD_TICKET_MAX_LENGTH=512
